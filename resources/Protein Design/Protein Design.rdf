                    <foaf:Person>
                        <foaf:surname>Cancedda</foaf:surname>
                        <foaf:givenName>Nicola</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Scialom</foaf:surname>
                        <foaf:givenName>Thomas</foaf:givenName>

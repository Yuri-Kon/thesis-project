                    <foaf:Person>
                        <foaf:surname>Lomeli</foaf:surname>
                        <foaf:givenName>Maria</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Zettlemoyer</foaf:surname>
                        <foaf:givenName>Luke</foaf:givenName>
                    </foaf:Person>

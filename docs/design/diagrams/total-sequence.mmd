sequenceDiagram
  autonumber
  participant U as Researcher
  participant API as FastAPI / TaskAPI
  participant WF as Workflow Runtime
  participant P as PlannerAgent
  participant KG as ProteinToolKG / Providers
  participant EX as ExecutorAgent
  participant ST as StepRunner
  participant S as SafetyAgent
  participant H as PendingAction / Decision
  participant L as EventLog
  participant K as TaskSnapshot
  participant SU as SummarizerAgent

  U->>API: POST /tasks (goal, constraints)
  API->>WF: create ProteinDesignTask + TaskRecord
  WF->>P: plan_with_status(task, context, record)
  P->>KG: retrieve tools + provider route
  KG-->>P: Top-K candidate inputs
  P-->>WF: plan_top_k + default recommendation

  alt plan gate requires HITL
    WF->>L: PENDING_ACTION_CREATED + WAITING_ENTER
    WF->>K: write TaskSnapshot(plan_confirm)
    WF-->>API: status = WAITING_PLAN_CONFIRM
    U->>API: POST /pending-actions/{id}/decision
    API->>H: validate and build Decision
    H-->>WF: apply_plan_confirm_decision
    WF->>L: DECISION_APPLIED + WAITING_EXIT
    WF->>K: write TaskSnapshot(after decision)
  else auto approve
    WF-->>API: status = PLANNED
  end

  API->>EX: run_plan(plan, context, record)
  EX->>S: check_task_input
  alt task input blocked
    EX->>L: WAITING_ENTER(replan_confirm)
    EX->>K: write TaskSnapshot(replan_confirm)
  else enter step loop
    loop for each plan step
      EX->>ST: run_step_with_patch(step_k)
      ST->>S: pre_step / post_step safety
      ST->>L: STEP_FINISHED / STEP_FAILED

      alt retry exhausted or patch gate triggered
        EX->>P: patch_top_k(request)
        P-->>EX: Patch candidates
        alt patch requires HITL
          EX->>L: WAITING_ENTER(patch_confirm)
          EX->>K: write TaskSnapshot(patch_confirm)
          U->>API: submit patch decision
          API->>H: apply_patch_confirm_decision
          H-->>EX: PATCHING -> RUNNING
        else auto patch
          EX->>ST: apply default patch and rerun step
        end
      end

      alt safety block or patch escalation
        EX->>P: replan_top_k(request)
        P-->>EX: Replan candidates
        alt replan requires HITL
          EX->>L: WAITING_ENTER(replan_confirm)
          EX->>K: write TaskSnapshot(replan_confirm)
          U->>API: submit replan decision
          API->>H: apply_replan_confirm_decision
          H-->>EX: REPLANNING / RUNNING
        else auto replan
          EX-->>WF: replace suffix plan and continue
        end
      end
    end
  end

  EX->>SU: summarize_and_finalize(context)
  SU->>L: report metadata / execution summary
  SU-->>API: DesignResult + report_path
  API-->>U: TaskRecord(status, pending_action, report_path)

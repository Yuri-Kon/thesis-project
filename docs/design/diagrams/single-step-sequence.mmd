sequenceDiagram
  autonumber
  participant EX as PatchRunner / ExecutorAgent
  participant ST as StepRunner
  participant AD as ToolAdapter
  participant SA as SafetyAgent
  participant P as PlannerAgent
  participant H as PendingAction / Decision
  participant L as EventLog
  participant K as TaskSnapshot

  EX->>ST: run_step_with_patch(step_k)
  ST->>SA: check_pre_step(step_k)

  alt pre-step block
    SA-->>ST: block
    ST->>L: STEP_FAILED (failure_type = safety_block)
    EX->>P: replan_top_k(request)
  else continue execution
    ST->>AD: resolve_inputs + run(tool, inputs)

    alt tool success
      AD-->>ST: outputs + metrics
      ST->>SA: check_post_step(step_result)
      alt allow or warn
        ST->>L: STEP_FINISHED
        EX-->>EX: continue next step
      else block
        ST->>L: STEP_FAILED (post-step safety block)
        EX->>P: replan_top_k(request)
      end

    else tool failure
      AD-->>ST: error / timeout / bad io
      ST->>L: STEP_FAILED

      alt retryable and attempts remain
        ST-->>ST: backoff + retry
      else retry exhausted or patch_required
        EX->>P: patch_top_k(request)
        P-->>EX: Patch candidates

        alt patch gate requires HITL
          EX->>L: WAITING_ENTER(patch_confirm)
          EX->>K: write TaskSnapshot(patch_confirm)
          H-->>EX: Decision(accept | replan | cancel)
          alt accept patch
            EX->>L: DECISION_APPLIED + WAITING_EXIT
            EX-->>EX: apply patch -> PATCHING
            EX->>ST: rerun patched step
          else replan
            EX->>L: WAITING_ENTER(replan_confirm)
            EX->>K: write TaskSnapshot(replan_confirm)
          else cancel
            EX->>L: terminal transition / cancellation
          end
        else auto patch path
          EX-->>EX: apply default patch candidate
          EX->>ST: rerun patched step
        end
      end
    end
  end

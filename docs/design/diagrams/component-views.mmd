flowchart LR

subgraph I["Interface & HITL"]
  U["Researcher"]
  API["FastAPI / UI\nTask API + PendingAction Dashboard + Timeline"]
  DA["Decision Apply\nplan_confirm / patch_confirm / replan_confirm"]
end

subgraph C["Planning & Control"]
  WF["Workflow Runtime\nrun_task_sync / WorkflowContext / TaskRecord"]
  PL["PlannerAgent"]
  KG["ProteinToolKG"]
  LLM["LLM Providers / Baseline Route"]
end

subgraph E["Execution & Recovery"]
  EX["ExecutorAgent\nPlanRunner / PatchRunner"]
  SR["StepRunner + AdapterRegistry"]
  SA["SafetyAgent"]
  SU["SummarizerAgent"]
end

subgraph T["Tooling"]
  TA["Tool Adapters\nProteinMPNN / ProtGPT2 / ESMFold / OpenFold3\nBioPython QC / MMseqs2 / BLASTP / DSSP"]
  RE["Remote / Local Engines\nremote_model_service / python adapters / visualization"]
end

subgraph P["Persistence & Outputs"]
  LOG["EventLog\n(data/logs/*.jsonl)"]
  SNAP["TaskSnapshot\n(data/snapshots/*.jsonl)"]
  OUT["Reports & Artifacts\n(output/reports / HTML / PDB / metrics)"]
end

